{"nodes": [{"id": "_scratch_pr_bp_sensitivity_model_issues_04_pr_15_49_age_matched_run_pr_15_49_age_matched_run", "label": "Issue 04: PR 15-49 Age-Matched Run", "file_type": "concept", "source_file": ".scratch/pr-bp-sensitivity-model/issues/04-pr-15-49-age-matched-run.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved as configuration on the shared pipeline. pr_15_49_config adds a single SampleFilter on age_15_49 on top of the PR 15+ filters; the previous age <= 49 filter was removed so the configured sample cannot drift from build_pr_features. reconcile_pr_15_49_sample and pr_sample_summary share the flag definition, and the run loads the saved PR split assignment, filtering to its case_ids with no re-split. The CLI refuses --no-split-assignment for 15-49 because a fresh partition would confound the comparison; calibration and threshold come from the run's own out-of-fold predictions. Config metadata carries sample, run_role, and comparison_run."}], "edges": [{"source": "_scratch_pr_bp_sensitivity_model_issues_04_pr_15_49_age_matched_run_pr_15_49_age_matched_run", "target": "_scratch_pr_bp_sensitivity_model_spec_pr_15_plus_bp_sensitivity_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/pr-bp-sensitivity-model/issues/04-pr-15-49-age-matched-run.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_pr_bp_sensitivity_model_issues_04_pr_15_49_age_matched_run_pr_15_49_age_matched_run", "target": "_scratch_pr_bp_sensitivity_model_issues_03_pr_15_plus_bp_model_run_pr_15_plus_bp_model_run", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/pr-bp-sensitivity-model/issues/04-pr-15-49-age-matched-run.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_pr_bp_sensitivity_model_issues_04_pr_15_49_age_matched_run_pr_15_49_age_matched_run", "target": "src_screen