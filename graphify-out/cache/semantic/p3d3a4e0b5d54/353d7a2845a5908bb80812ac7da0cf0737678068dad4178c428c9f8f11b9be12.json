{"nodes": [{"id": "_scratch_pr_bp_sensitivity_model_issues_06_primary_vs_pr_comparison_report_primary_vs_pr_comparison_report", "label": "Issue 06: Primary vs PR Comparison Report", "file_type": "concept", "source_file": ".scratch/pr-bp-sensitivity-model/issues/06-primary-vs-pr-comparison-report.md", "source_location": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved in src/screener/pr_comparison.py. compare_primary_vs_pr is pure over three finished TrainingResults and returns run snapshots, sample and feature tables, overall and weighted metric blocks, descriptive deltas, reliability curves, sex and age-band rows, PR subgroup gaps, narrative, and limitations. Missing metrics render as n/a rather than raising, so a partial run stays comparable without inventing values; composition is reported on the test set because that is the set every run's metrics use. load_run_result reconstructs a result from a finished run's artifacts, and the CLI writes both Markdown and JSON. A review pass moved the shared scalar formatters into reporting.py."}], "edges": [{"source": "_scratch_pr_bp_sensitivity_model_issues_06_primary_vs_pr_comparison_report_primary_vs_pr_comparison_report", "target": "_scratch_pr_bp_sensitivity_model_spec_pr_15_plus_bp_sensitivity_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/pr-bp-sensitivity-model/issues/06-primary-vs-pr-comparison-report.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_pr_bp_sensitivity_model_issues_06_primary_vs_pr_comparison_report_primary_vs_pr_comparison_report", "target": "_scratch_pr_bp_sensitivity_model_spec_comparison_report", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/pr-bp-sensitivity-model/issues/06-primary-vs-pr-comparison-report.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_pr_bp_sensitivity_model_issues_06_primary_vs_pr_comp