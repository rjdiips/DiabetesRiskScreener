{"nodes": [{"id": "_scratch_pr_bp_sensitivity_model_issues_05_pr_subgroups_fairness_and_variants_pr_subgroup_fairness_and_feature_set_variants", "label": "Issue 05: PR Subgroups, Fairness, and Feature-Set Variants", "file_type": "concept", "source_file": ".scratch/pr-bp-sensitivity-model/issues/05-pr-subgroups-fairness-and-variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved inside the shared pipeline seam. _subgroup_metrics emits n, positives, prevalence, ROC-AUC, PR-AUC, sensitivity, specificity, ECE, gaps versus overall, a reliable flag, an unreliable_reason, and the audit-only note; the 200-row/50-positive and 500-row state rules became small_group_min_rows, small_group_min_positives, and state_min_test_rows config fields. Religion and social group join the subgroup set only for fairness and combined variants so exclusion decisions are tested rather than assumed. Variant comparison is a pure helper in src/screener/pr_variants.py that reports added/removed features and deltas and does not treat higher ROC-AUC as proof a variant is better; scripts/run_pr_variants.py requires the saved split assignment."}], "edges": [{"source": "_scratch_pr_bp_sensitivity_model_issues_05_pr_subgroups_fairness_and_variants_pr_subgroup_fairness_and_feature_set_variants", "target": "_scratch_pr_bp_sensitivity_model_spec_pr_15_plus_bp_sensitivity_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/pr-bp-sensitivity-model/issues/05-pr-subgroups-fairness-and-variants.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_pr_bp_sensitivity_model_issues_05_pr_subgroups_fairness_and_variants_pr_subgroup_fairness_and_feature_set_variants", "target": "_scratch_pr_bp_sensitivity_model_spec_default_pr_bp_feature_set", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/pr-bp-sensitivity-mo