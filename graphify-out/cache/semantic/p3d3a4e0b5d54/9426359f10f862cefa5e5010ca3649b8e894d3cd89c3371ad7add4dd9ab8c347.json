{"nodes": [{"id": "_scratch_review_cleanup_and_py311_rerun_issues_01_shared_run_summary_shared_run_summary_and_row_count_accessor", "label": "Cleanup Issue 01: Shared Run Summary and Row-Count Accessor", "file_type": "concept", "source_file": ".scratch/review-cleanup-and-py311-rerun/issues/01-shared-run-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved. build_run_summary builds the printed mapping and TrainingResult.row_counts is the single accessor the summary reads; both entry points call the shared function and no longer build the mapping inline. sample defaults to the pipeline's recorded label so the primary run does not duplicate the constant, while PR runs pass the CLI sample name and print the metadata label separately. Verified with 1,000-row smoke runs on both entry points: the PR JSON is identical except run_dir, and the primary JSON keeps every value and gains only sample_label and comparison_run, giving both the same shape and key order."}], "edges": [{"source": "_scratch_review_cleanup_and_py311_rerun_issues_01_shared_run_summary_shared_run_summary_and_row_count_accessor", "target": "_scratch_review_cleanup_and_py311_rerun_spec_review_cleanup_and_python_3_11_rerun", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/review-cleanup-and-py311-rerun/issues/01-shared-run-summary.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_review_cleanup_and_py311_rerun_issues_01_shared_run_summary_shared_run_summary_and_row_count_accessor", "target": "_scratch_review_cleanup_and_py311_rerun_spec_shared_run_summary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".scratch/review-cleanup-and-py311-rerun/issues/01-shared-run-summary.md", "source_location": null, "weight": 1.0}, {"source": "_scratch_review_cleanup_and_py311_rerun_issues_01_shared_run_summary_shared_run_s